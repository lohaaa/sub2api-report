root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{json,jsonc,js,jsx,ts,tsx,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion

dotnet_naming_rule.private_const_fields_pascal.symbols = private_const_fields
dotnet_naming_rule.private_const_fields_pascal.style = pascal_case
dotnet_naming_rule.private_const_fields_pascal.severity = error

dotnet_naming_rule.private_static_fields_pascal.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_pascal.style = pascal_case
dotnet_naming_rule.private_static_fields_pascal.severity = error

dotnet_naming_rule.private_instance_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_instance_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_instance_fields_underscore.severity = error

dotnet_naming_symbols.private_const_fields.applicable_kinds = field
dotnet_naming_symbols.private_const_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_const_fields.required_modifiers = const

dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Minimal API response records are consumed by System.Text.Json outside static call analysis.
[src/Sub2ApiReport.Api/Models/*.cs]
resharper_not_accessed_positional_property_global_highlighting = none

# The updater status contract is serialized by the standalone updater host.
[src/Sub2ApiReport.UpdateContracts/*.cs]
resharper_not_accessed_positional_property_global_highlighting = none

# EF Core discovers this factory through IDesignTimeDbContextFactory reflection.
[src/Sub2ApiReport.Infrastructure/Persistence/DesignTimeReportDbContextFactory.cs]
resharper_unused_type_global_highlighting = none

# EF migration files are generated and removed only through dotnet-ef.
[src/Sub2ApiReport.Infrastructure/Persistence/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
