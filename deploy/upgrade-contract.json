{
  "schemaVersion": 1,
  "deploymentContractVersion": 1,
  "architecture": "linux/amd64",
  "distribution": {
    "type": "github-release-assets",
    "registryPullEnabled": false,
    "appImageTag": "sub2api-report-app:current",
    "updaterImageTag": "sub2api-report-updater:bootstrap"
  },
  "app": {
    "internalPort": 8080,
    "dataPath": "/data",
    "livenessPath": "/health/live",
    "readinessPath": "/health/ready",
    "updaterTokenPath": "/run/secrets/updater-token"
  },
  "updater": {
    "internalPort": 8081,
    "statePath": "/update-state",
    "tokenPath": "/run/secrets/updater-token",
    "installationEnabled": false,
    "selfUpdateEnabled": false
  }
}
