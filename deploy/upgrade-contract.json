{
  "schemaVersion": 2,
  "deploymentContractVersion": 2,
  "architecture": "linux/amd64",
  "distribution": {
    "type": "github-release-assets",
    "registryPullEnabled": false,
    "appImageTag": "sub2api-report-app:current"
  },
  "app": {
    "internalPort": 8080,
    "dataPath": "/data",
    "livenessPath": "/health/live",
    "readinessPath": "/health/ready"
  },
  "update": {
    "method": "host-bootstrap",
    "databaseBackupRequired": true,
    "automaticRollbackRequired": true
  }
}
