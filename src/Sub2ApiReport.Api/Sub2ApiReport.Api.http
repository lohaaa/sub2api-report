@baseUrl = http://localhost:5080
@setupCode = REPLACE-WITH-STARTUP-CODE
@username = synthetic-admin
@password = ValidPassword1!
@sub2ApiBaseUrl = https://sub2api.example.com
@sub2ApiAdminKey = REPLACE-WITH-SUB2API-ADMIN-KEY
@sub2ApiUserId = 42
@sub2ApiGroupId = 7
@reportDownloadToken = REPLACE-WITH-TOKEN-FROM-IM-LINK
@reportDownloadGrantId = REPLACE-WITH-GRANT-ID

### Liveness
GET {{baseUrl}}/health/live

### Readiness
GET {{baseUrl}}/health/ready

### System version
GET {{baseUrl}}/api/v1/system/version

### Setup status
GET {{baseUrl}}/api/v1/setup/status

### Get antiforgery token and cookie
# @name antiforgery
GET {{baseUrl}}/api/v1/security/antiforgery

### Initialize the only administrator
POST {{baseUrl}}/api/v1/setup/initialize
Content-Type: application/json
X-CSRF-TOKEN: {{antiforgery.response.body.$.token}}

{
  "code": "{{setupCode}}",
  "username": "{{username}}",
  "password": "{{password}}"
}

### Refresh antiforgery token after initialization
# @name authenticatedAntiforgery
GET {{baseUrl}}/api/v1/security/antiforgery

### Login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### Current administrator
GET {{baseUrl}}/api/v1/auth/me

### Dynamic system settings
# @name systemSettings
GET {{baseUrl}}/api/v1/system/settings

### Configure revocable report download links
PUT {{baseUrl}}/api/v1/system/settings
Content-Type: application/json
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

{
  "timezone": "{{systemSettings.response.body.$.timezone}}",
  "logLevel": "{{systemSettings.response.body.$.logLevel}}",
  "reportConcurrency": {{systemSettings.response.body.$.reportConcurrency}},
  "reportRetentionMonths": {{systemSettings.response.body.$.reportRetentionMonths}},
  "backupRetentionCount": {{systemSettings.response.body.$.backupRetentionCount}},
  "reportExternalBaseUrl": "https://reports.example.com",
  "reportDownloadLinkHours": 24,
  "reportDownloadMaxDownloads": 20,
  "revision": {{systemSettings.response.body.$.revision}}
}

### Create a short step-up authorization
POST {{baseUrl}}/api/v1/auth/step-up
Content-Type: application/json
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

{
  "password": "{{password}}"
}

### Save the encrypted Sub2API connection after step-up
PUT {{baseUrl}}/api/v1/sub2api/connection
Content-Type: application/json
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

{
  "baseUrl": "{{sub2ApiBaseUrl}}",
  "adminApiKey": "{{sub2ApiAdminKey}}",
  "clearAdminApiKey": false,
  "userId": "{{sub2ApiUserId}}",
  "codexGroupId": "{{sub2ApiGroupId}}",
  "revision": 0
}

### Test the saved Sub2API connection
POST {{baseUrl}}/api/v1/sub2api/connection/test
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

### Synchronize all upstream Key pages
POST {{baseUrl}}/api/v1/sub2api/keys/sync
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

### Read the local masked Key inventory
# @name keys
GET {{baseUrl}}/api/v1/sub2api/keys?page=1&pageSize=50&unmappedOnly=true

### Generate and persist a manual dry-run report
# @name generateReport
POST {{baseUrl}}/api/v1/reports/dry-run
Content-Type: application/json
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

{
  "cutoffDate": null,
  "windows": [
    {
      "key": "rolling_7_days",
      "kind": "RollingDays",
      "rollingDays": 7,
      "weekStartsOn": null,
      "customStartDate": null,
      "customEndDate": null
    },
    {
      "key": "previous_calendar_month",
      "kind": "PreviousCalendarMonth",
      "rollingDays": null,
      "weekStartsOn": null,
      "customStartDate": null,
      "customEndDate": null
    }
  ]
}

### List immutable report snapshots
GET {{baseUrl}}/api/v1/reports?page=1&pageSize=25

### Create an email notification channel
# @name createEmailChannel
POST {{baseUrl}}/api/v1/channels
Content-Type: application/json
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

{
  "type": "Email",
  "name": "Synthetic Email Channel",
  "enabled": true,
  "email": {
    "host": "smtp.example.com",
    "port": 587,
    "security": "StartTls",
    "username": "reports@example.com",
    "fromAddress": "reports@example.com",
    "fromName": "Sub2API Report",
    "toAddresses": ["recipient@example.com"],
    "ccAddresses": []
  },
  "smtpPassword": null,
  "webhookUrl": null,
  "signSecret": null
}

### Create a DingTalk webhook channel
# @name createDingTalkChannel
POST {{baseUrl}}/api/v1/channels
Content-Type: application/json
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

{
  "type": "DingTalk",
  "name": "Synthetic DingTalk Channel",
  "enabled": true,
  "email": null,
  "smtpPassword": null,
  "webhookUrl": "https://oapi.dingtalk.com/robot/send?access_token=REPLACE-WITH-TOKEN",
  "signSecret": "REPLACE-WITH-SECRET"
}

### List channels with masked secrets
GET {{baseUrl}}/api/v1/channels

### Replace channel settings (secrets kept when empty)
PUT {{baseUrl}}/api/v1/channels/{{createEmailChannel.response.body.$.id}}
Content-Type: application/json
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

{
  "name": "Synthetic Email Channel",
  "enabled": true,
  "email": {
    "host": "smtp.example.com",
    "port": 587,
    "security": "StartTls",
    "username": "reports@example.com",
    "fromAddress": "reports@example.com",
    "fromName": "Sub2API Report",
    "toAddresses": ["recipient@example.com"],
    "ccAddresses": []
  },
  "removeStoredPassword": false,
  "newSmtpPassword": null,
  "webhookUrl": null,
  "signSecret": null,
  "revision": 1
}

### Send a synthetic test message to one channel
POST {{baseUrl}}/api/v1/channels/{{createEmailChannel.response.body.$.id}}/test
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

### Deliver the saved report to selected channels
# @name deliverReport
POST {{baseUrl}}/api/v1/reports/{{generateReport.response.body.$.reportId}}/deliveries
Content-Type: application/json
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

{
  "channelIds": ["{{createEmailChannel.response.body.$.id}}"],
  "confirmPartial": false
}

### List delivery runs and per-channel states
GET {{baseUrl}}/api/v1/reports/{{generateReport.response.body.$.reportId}}/deliveries

### Download XLSX through an anonymous limited grant
GET {{baseUrl}}/api/v1/report-downloads/xlsx?token={{reportDownloadToken}}

### Revoke one report download grant
POST {{baseUrl}}/api/v1/reports/{{generateReport.response.body.$.reportId}}/download-grants/{{reportDownloadGrantId}}/revoke
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

### Retry only the failed channels of a run
POST {{baseUrl}}/api/v1/reports/{{generateReport.response.body.$.reportId}}/deliveries/{{deliverReport.response.body.$.id}}/retry
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

### Read the generated canonical report snapshot
GET {{baseUrl}}/api/v1/reports/{{generateReport.response.body.$.reportId}}

### Download the generated XLSX workbook
GET {{baseUrl}}/api/v1/reports/{{generateReport.response.body.$.reportId}}/xlsx

### Read the persistent monthly schedule
# @name reportSchedule
GET {{baseUrl}}/api/v1/schedule

### Update and enable the monthly schedule
PUT {{baseUrl}}/api/v1/schedule
Content-Type: application/json
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

{
  "enabled": true,
  "dayOfMonth": 1,
  "localTime": "09:00",
  "timezone": "Asia/Shanghai",
  "windows": [
    {
      "key": "rolling_30_days",
      "kind": "RollingDays",
      "rollingDays": 30,
      "weekStartsOn": null,
      "customStartDate": null,
      "customEndDate": null
    },
    {
      "key": "previous_calendar_month",
      "kind": "PreviousCalendarMonth",
      "rollingDays": null,
      "weekStartsOn": null,
      "customStartDate": null,
      "customEndDate": null
    }
  ],
  "revision": {{reportSchedule.response.body.$.revision}}
}

### Queue an immediate report task
# @name runReportTask
POST {{baseUrl}}/api/v1/schedule/run
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

### List normalized task execution records
GET {{baseUrl}}/api/v1/schedule/runs?page=1&pageSize=20

### Retry a terminal failed task (set confirmation only after reviewing unknown outcomes)
POST {{baseUrl}}/api/v1/schedule/runs/{{runReportTask.response.body.$.id}}/retry
Content-Type: application/json
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

{
  "confirmOutcomeUnknown": false
}

### Logout
POST {{baseUrl}}/api/v1/auth/logout
X-CSRF-TOKEN: {{authenticatedAntiforgery.response.body.$.token}}

### Unknown API route returns Problem Details, not the SPA
GET {{baseUrl}}/api/v1/unknown
